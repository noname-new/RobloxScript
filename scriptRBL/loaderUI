--// UI FUNCTIONS
--// =========================================

local Closing = false

local function SetStatus(text)
    if StatusLabel and StatusLabel.Parent then
        StatusLabel.Text = "● " .. tostring(text)
    end
end

local function SetProgress(value)
    value = math.clamp(tonumber(value) or 0, 0, 1)

    if not Progress or not Progress.Parent then
        return
    end

    TweenService:Create(
        Progress,
        TweenInfo.new(
            0.25,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {
            Size = UDim2.fromScale(value, 1)
        }
    ):Play()

    if Percent and Percent.Parent then
        Percent.Text = string.format(
            "%d%%",
            math.floor(value * 100 + 0.5)
        )
    end
end

--// =========================================
--// FADE OUT + DESTROY
--// =========================================

local function CloseUI()
    if Closing then
        return
    end

    Closing = true

    if not Gui or not Gui.Parent then
        return
    end

    local TweenInfoOut = TweenInfo.new(
        0.35,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.In
    )

    -- Main
    TweenService:Create(
        Main,
        TweenInfoOut,
        {
            BackgroundTransparency = 1,
            Position = UDim2.fromScale(0.5, 0.48)
        }
    ):Play()

    -- Children
    for _, object in ipairs(Main:GetDescendants()) do

        if object:IsA("TextLabel") then

            TweenService:Create(
                object,
                TweenInfoOut,
                {
                    TextTransparency = 1
                }
            ):Play()

        elseif object:IsA("Frame") then

            TweenService:Create(
                object,
                TweenInfoOut,
                {
                    BackgroundTransparency = 1
                }
            ):Play()

        elseif object:IsA("UIStroke") then

            TweenService:Create(
                object,
                TweenInfoOut,
                {
                    Transparency = 1
                }
            ):Play()

        end
    end

    task.wait(0.4)

    if Gui and Gui.Parent then
        Gui:Destroy()
    end
end

--// =========================================
--// RUNTIME LOADER - GITHUB RAW (FIXED)
--// =========================================

local function LoadScript(name, data, progressCallback)
    if not data or not data.File then
        return false, "Invalid game data"
    end

    print("[Loader] Loading:", name)
    print("[Loader] File:", data.File)

    if progressCallback then
        progressCallback(0.65)
    end

    -- Tạo URL từ GitHub
    local url = GITHUB_BASE .. data.File
    print("[Loader] Fetching:", url)

    -- Tải script
    local success, content = pcall(function()
        return game:HttpGet(url)
    end)

    if not success then
        return false, "Failed to fetch script: " .. tostring(content)
    end

    if not content or content == "" then
        return false, "Script content is empty"
    end

    if progressCallback then
        progressCallback(0.80)
    end

    -- Compile script
    local fn, err = loadstring(content)

    if not fn then
        return false, "Failed to compile script: " .. tostring(err)
    end

    if progressCallback then
        progressCallback(0.90)
    end

    -- Chạy script
    local ok, result = pcall(fn)

    if not ok then
        return false, "Script execution failed: " .. tostring(result)
    end

    if progressCallback then
        progressCallback(1)
    end

    return true, result
end

--// =========================================
--// AUTO LOAD
--// =========================================

task.spawn(function()

    -- Detecting
    SetStatus("Detecting...")
    SetProgress(0.10)

    task.wait(0.35)

    -- Game check
    if not GameName or not GameData then

        SetStatus("Unsupported")
        SetProgress(1)

        task.wait(1)

        CloseUI()

        return
    end

    -- Detected
    SetStatus("Game detected: " .. GameName)
    SetProgress(0.35)

    task.wait(0.25)

    -- Loading
    SetStatus("Loading " .. GameName .. "...")
    SetProgress(0.50)

    local success, result = LoadScript(
        GameName,
        GameData,
        function(progress)
            SetProgress(progress)
        end
    )

    if not success then

        warn("[Loader] Load failed:", tostring(result))

        SetStatus("Failed: " .. tostring(result))
        SetProgress(1)

        task.wait(1.5)

        CloseUI()

        return
    end

    -- Loaded
    SetStatus("✅ Loaded successfully!")
    SetProgress(1)

    task.wait(0.7)

    CloseUI()
end)

print("[Loader] Auto Loader is running...")

return Loader
