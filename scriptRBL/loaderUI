--// =========================================
--// GAME LOOKUP
--// =========================================

function Loader:GetGame(gameId)
    gameId = tonumber(gameId)

    if not gameId then
        return nil, nil
    end

    for gameName, data in pairs(self.Files) do
        if tonumber(data.GameId) == gameId then
            return gameName, data
        end
    end

    return nil, nil
end

