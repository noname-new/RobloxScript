function Loader:LoadByGameId(GameId)

    for GameName, Data in pairs(self.Files) do
        print("Checking:", GameName, Data.GameId)

        if Data.GameId == GameId then
            print("Matched!")

            local Url = "https://raw.githubusercontent.com/noname-new/RobloxScript/refs/scriptRBL/" .. Data.File

            print("Loading:", Url)

            local Success, Result = pcall(function()
                return loadstring(game:HttpGet(Url))()
            end)

            if Success then
                print("✅ Loaded:", GameName)
            else
                warn("❌ Load failed:", Result)
            end

            return
        end
    end

    warn("UNSUPPORTED GAME")
end

